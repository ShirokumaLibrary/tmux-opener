.vscode/**
.claude/**
# Dev-only: Claude Code guidance (also .gitattributes export-ignored, so it
# never reaches the public repo — but a VSIX built here would still bundle it).
CLAUDE.md
src/**
.gitignore
scripts/**
tsconfig.json
# Glob, not a name: the flat-config file may be .mjs/.js/.cjs/.ts. It was once
# named .eslintrc.json here, and renaming it leaked into the VSIX — a name-based
# exclude repeats that trap. tsconfig.json above is left name-based: TypeScript
# only reads that exact filename, so its extension can't drift.
eslint.config.*
out/**
**/*.map
**/.git/**
tmp/**
# Dev-only: the node --test suite. The webview modules it exercises
# (media/webview-keymap.js, media/webview-sound.js, media/webview-font.js) are
# NOT dev-only — media/** is not excluded here, so they ship, which is what the
# webview's <script> tags need.
test/**
# Dev-only: the reference scripts installed into ~/.claude (statusline, hooks).
# Users get them from the repo — `npm run claude:install`, or the links in the
# README for VSIX users — so they needn't bloat the VSIX (#41).
#
# NOT the same thing as `.claude/**` on line 2: that one is this repo's own
# Claude Code *settings*, this one is the *distributed scripts*. One character
# apart, and deleting the wrong one either leaks the dev settings or ships the
# distributables. This exclude is name-based and a rename silently defeats it
# (see eslint.config.* above), so if `claude/` is ever renamed, this line must
# move with it in the same commit — scripts/verify-vsix.js asserts the absence
# of `extension/claude/` so the mistake fails the release gate (#83).
claude/**
# Dev-only: shirokuma-flow config, rules and the .shirokuma/tmp review scratch.
.shirokuma/**
# Dev-only: local nginx preview for the .shirokuma/pages confirmation-view submodule.
infra/**
# The sibling font extensions (each its own VSIX, e.g. font-mplus1code)
# live here as source; they are packaged separately, never bundled into this
# extension's VSIX. Their bundled .ttf alone is ~3.9MB per package. This exclude
# is name-based, so scripts/verify-vsix.js asserts the absence of
# `extension/font-packages/` to fail the release gate if the tree is ever renamed.
font-packages/**
# Nothing lives here today (the release workflow was removed with GitHub Actions),
# but repository metadata never belongs inside a VSIX. Kept so re-adding an issue
# template or a workflow can't leak into the package.
.github/**
node_modules/node-addon-api/**
# node-pty resolves its binary as build/Release -> build/Debug ->
# prebuilds/<platform>-<arch> (lib/utils.js). Linux has no prebuild and is
# compiled into build/Release at install time; macOS ships one. Both must stay.
# Windows can't run this extension at all — we spawn tmux directly — and its
# prebuilds are 58MB of the two.
node_modules/node-pty/prebuilds/win32-x64/**
node_modules/node-pty/prebuilds/win32-arm64/**
node_modules/node-pty/third_party/**
node_modules/node-pty/deps/**
node_modules/node-pty/src/**
node_modules/node-pty/scripts/**
node_modules/node-pty/typings/**
node_modules/node-pty/binding.gyp
node_modules/node-pty/README.md
node_modules/node-pty/LICENSE
